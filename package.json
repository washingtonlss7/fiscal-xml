{
  "name": "fiscal-xml",
  "version": "0.1.0",
  "private": true,
  "description": "Coletor de NF-e e CT-e via DistribuicaoDFe (SEFAZ) com certificado A1 do cliente",
  "main": "dist/worker.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/worker.js",
    "dev": "tsx src/worker.ts",
    "teste-sefaz": "tsx src/cli/teste-sefaz.ts",
    "cadastrar-empresa": "tsx src/cli/cadastrar-empresa.ts",
    "prod:teste-sefaz": "node dist/cli/teste-sefaz.js",
    "prod:cadastrar-empresa": "node dist/cli/cadastrar-empresa.js",
    "gerar-chave": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "test": "tsx test/parse.test.ts && tsx test/evento.test.ts && tsx test/extrator.test.ts && tsx test/zip.test.ts && tsx test/auditoria.test.ts && tsx test/armazenamento.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^18.0.4",
    "fast-xml-parser": "^5.11.1",
    "node-cron": "^4.6.0",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/node-forge": "^1.3.14",
    "@xmldom/xmldom": "^0.9.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "xml-crypto": "^6.3.2"
  }
}
