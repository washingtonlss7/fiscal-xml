# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave service_role: só no servidor, nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cifra dos certificados ---
# 32 bytes em base64. Gere com: npm run gerar-chave
# Guarde uma cópia segura: sem ela os certificados gravados não podem ser lidos.
MASTER_KEY=

# --- SEFAZ ---
# 1 = produção, 2 = homologação
TP_AMB=1
# Cadeia ICP-Brasil (o Dockerfile já baixa em /app/certs/icp-brasil.pem)
# SEFAZ_CA_FILE=./certs/icp-brasil.pem

# --- Agendamento ---
# Horário em que o coletor consulta a SEFAZ (fuso de São Paulo). Fora dele, nenhuma chamada é feita.
# Padrão 23-6 (23h às 6h), pedido do escritório para não disputar com o software dos clientes.
# Use 0-24 para liberar o dia todo. Configure o mesmo valor no coletor e no painel.
JANELA_SINCRONIZACAO=23-6
# Empresas sincronizando ao mesmo tempo. Quando uma termina, a vaga passa para a próxima que está na vez.
CONCORRENCIA=30
# Cada empresa volta a consultar a SEFAZ a cada N horas depois de ficar em dia (mínimo 1 h, regra da SEFAZ).
INTERVALO_HORAS=3
MAX_CHAMADAS_POR_RODADA=40
XML_BUCKET=xmls
LOG_LEVEL=info

# --- Cloudflare R2 (XMLs criptografados). Sem estas variáveis, os XMLs ficam no Supabase Storage. ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=fiscal-xml

# --- Backup semanal dos XMLs no disco da VPS (volume montado em /app/backup) ---
# BACKUP_DIR=/app/backup
# BACKUP_CRON=30 3 * * 0
